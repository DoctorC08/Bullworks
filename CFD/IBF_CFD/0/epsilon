FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.7188.; // Calculated epsilon value

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.7188.; // Should be the same as internalField
    }
    outlet
    {
        type            zeroGradient;
    }
    front
    {
        type            freestream;
        freestreamValue uniform 0.7188.;
    }
    back
    {
        type            freestream;
        freestreamValue uniform 0.7188.;
    }
    lowerWall
    {
        type            freestream;
        freestreamValue uniform 0.7188.;
    }
    upperWall
    {
        type            freestream;
        freestreamValue uniform 0.7188.;
    }
    IBF_snappyHexMesh
    {
        type            epsilonWallFunction;
        value           uniform 0.7188.;
    }
    defaultFaces
    {
        type            empty;
    }
}


