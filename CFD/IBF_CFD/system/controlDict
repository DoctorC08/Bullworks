FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          incompressibleFluid;

startFrom       startTime; /* Set to latestTime if we want to pause and resume*/

startTime       0;

stopAt          endTime;

endTime         1; /* Run for 10 seconds */

deltaT          0.001;

adjustTimeStep  true;

maxCo           0.5;

writeControl    timeStep;

writeInterval   0.1;

purgeWrite      200; /* For IBF it's about 500mb per file, so let's cap at 100gb stored*/

writeFormat     binary; /* Use binary to conserve storage*/

writePrecision  6;

writeCompression on;

timeFormat      general;

timePrecision   6;

runTimeModifiable true; /* This allows for modification in the middle of a run */

