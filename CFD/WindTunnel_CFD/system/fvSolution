solvers
{
    p
    {
        solver          GAMG; // Fast multi-grid solver for pressure
        tolerance       1e-7;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    "(U|k|omega|epsilon)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 2; // Increase to 1 or 2 if your mesh quality is poor
    consistent      yes;        // Uses SIMPLEC, which converges faster
}

relaxationFactors
{
    equations
    {
        U               0.9; // Higher values converge faster but are less stable
        k               0.5;
        omega           0.5;
    }
}

