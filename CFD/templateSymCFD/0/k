#include "$FOAM_CASE/system/include/caseVars" 

FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];


/*
k (turbulent kinetic energy) = 3/2 (U_avg * I)^2 where U_avg is avg. velocity (found in U file) and I is turbulence intensity (~1-5%)
*/
internalField   uniform k_value; /* Change this */

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform k_value; /* Change this */
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform k_value; /* Change this */
        value           uniform k_value; /* Change this */
    }
    lowerWall
    {
        type            kqRWallFunction;
        value           uniform k_value; /* Change this */
    }
    path_name 
    {
        type            kqRWallFunction;
        value           uniform k_value; /* Change this */
    }
    upperWall
    {
        type            symmetryPlane;
    }
    "(front|back)"
    {
        type            symmetryPlane;
    }
    "proc.*"
    {
        type            processor;
    }
}


