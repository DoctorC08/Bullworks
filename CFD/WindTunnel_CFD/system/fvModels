FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

disk
{
    type            rotorDiskSource;
    selectionMode   cellZone;
    cellZone        fanCellZone;
    
    // Physical Parameters
    nBlades         3;
    
    // Define the orientation and rotation
    origin          (2 .61695197 .26437480);
    axis            (1 0 0);
    
    // Define RPM as a Function1 (allows for constant or ramped values)
    omega           constant 188.5; // rad/s (1800 rpm * 2pi / 60)

    // Blade Geometry
    geometryMode    specified;
    radiusData
    (
        // radius   chord   twist (degrees)
        (0.1        0.08    25)
        (0.3        0.06    15)
        (0.5        0.04    8)
    );

    trimModel       none;
    
    leaf
    {
        type            lookup;
        data
        (
            // (AoA_deg  Cl      Cd)
            (-15        -0.8    0.1)
            (0           0.0    0.02)
            (15          1.2    0.15)
        );
    }
}


