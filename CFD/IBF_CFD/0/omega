FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

omegaValue      uniform 2.85;

internalField   ${omegaValue};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           ${omegaValue};
    }
    outlet
    {
        type            freestream;
        value           ${omegaValue}; 
    }
    IBF_snappyHexMesh
    {
        type            omegaWallFunction;
        value           ${omegaValue}; // Initial guess, wall function will override
    }
    ".*Wall"
    {
        type            freestream;
        value           ${omegaValue}; 
    }
}
