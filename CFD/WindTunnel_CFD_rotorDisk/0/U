FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

UValue          uniform (0 0 0); /* set air speed to 0  */

internalField   ${UValue};
 
boundaryField
{
    inlet
    {
        type            pressureInletOutletVelocity;
        value           ${UValue}; 
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            noSlip;
    }
    
}

