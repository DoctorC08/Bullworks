FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// kValue          uniform 0.012;
kValue          uniform 0.027; 

internalField   ${kValue};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           ${kValue};
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type             kqRWallFunction;
        value           ${internalField};
    }
}


