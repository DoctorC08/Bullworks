#include "$FOAM_CASE/system/include/caseVars" 

FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];


/* 
nuTilda can be approximated as 0.1 * v where v is the kinematic viscosity and at STP 1.5*10^(-5) m^2/s 
*/
internalField   uniform nuTilda_value; 

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform nuTilda_value; /* Change this */
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform nuTilda_value; /* Change this */
        value           uniform nuTilda_value; /* Change this */
    }
    lowerWall
    {
        type            fixedValue;
        value           uniform 0;
    }
    path_name
    {
        type            fixedValue;
        value           uniform 0;
    }
    upperWall
    {
        type            symmetryPlane;
    }
    "(front|back)"
    {
        type            symmetryPlane;
    }
    "proc.*"
    {
        type            processor;
    }
}


