FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

kValue          uniform 0.012;

internalField   ${kValue};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           ${kValue};
    }
    outlet
    {
        type            zeroGradient;
    }
    ".*Wall"
    {
        type            freestream;
        freestreamValue ${kValue};
    }
    IBF_snappyHexMesh
    {
        type            kqRWallFunction;
        value           ${kValue};
    }
    defaultFaces
    {
        type            freestream;
        value           ${kValue};
    }
}


