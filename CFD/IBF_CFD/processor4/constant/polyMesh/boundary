        inGroups        1(symmetryPlane);
        nFaces          0;
        startFace       1684;
    }
    back
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          104;
        startFace       1684;
    }
    inlet
    {
        type            patch;
        nFaces          48;
        startFace       1788;
    }
    outlet
    {
