FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

8
(
    front
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          120;
        startFace       1660;
    }
    back
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          0;
        startFace       1780;
    }
    inlet
    {
        type            patch;
        nFaces          40;
        startFace       1780;
    }
    outlet
    {
        type            patch;
        nFaces          0;
        startFace       1820;
    }
    lowerWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          80;
        startFace       1820;
    }
    upperWall
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          79;
        startFace       1900;
    }
    procBoundary1to0
    {
        type            processor;
        inGroups        1(processor);
        nFaces          56;
        startFace       1979;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    0;
    }
    procBoundary1to2
    {
        type            processor;
        inGroups        1(processor);
        nFaces          121;
        startFace       2035;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    2;
    }
)

